<controladores>

    <!-- OptiPan: confirma una orden de horneado y descuenta el inventario (US-003) -->
    <controlador nombre="Horneado">
        <hereda-de controlador="Typical"/>
        <accion nombre="confirmarHorneado" icono="check-bold" modo="detail"
                clase="com.tuempresa.Facturas.acciones.ConfirmarHorneadoAccion"/>
    </controlador>

    <controlador nombre="AlertaStockReporte">
        <hereda-de controlador="Typical"/>
        <accion nombre="generarOrdenCompraAutomatica" icono="report" modo="list"
                clase="com.tuempresa.Facturas.acciones.GenerarOrdenCompraAutomaticaAction"/>
    </controlador>

</controladores>
